# ============================================================
#  AlertNow — Web App Configuration
#  1. Copy this file → rename to  .env
#  2. Fill in your real values from Firebase Console
#  3. This file is loaded by config.js (keep it private!)
# ============================================================

# ── Firebase Project ─────────────────────────────────────────
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=alert-sas.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# ── FCM Server Key (Cloud Messaging → Legacy server key) ─────
# Found in: Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=AAAA_YOUR_FCM_SERVER_KEY_HERE

# ── Admin credentials (change these!) ───────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=alertnow123
